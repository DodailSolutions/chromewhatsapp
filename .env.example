# Copy to .env.local for local development (npm run dev). On Vercel, set these in Project → Settings → Environment Variables.

# Neon Postgres connection string. Added automatically when you connect Neon from the Vercel dashboard (Storage → Neon).
# For local testing without a database server, use the embedded one:  DATABASE_URL=pglite:.data/db
DATABASE_URL=

# Admin login for the dashboard (at least 8 characters; you can change it later in Settings).
ADMIN_USER=admin
ADMIN_PASSWORD=

# The license signing key (PKCS#8 PEM). `npm run setup` prints it from your old data/keys.json,
# or creates a new one. Keep it secret: anyone with it can create licenses.
LICENSE_PRIVATE_KEY=

# Optional
GRACE_DAYS=7
# SESSION_SECRET=   (defaults to a value derived from LICENSE_PRIVATE_KEY)
